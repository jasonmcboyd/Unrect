<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Restores resolve from nuget.org and nothing else. Without the fallback clear a restore
       inherits whatever fallback folders the machine declares — a Visual Studio install path that
       exists on one developer's box and on no CI runner — and the build then fails resolving assets
       from a directory that is not there. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

</configuration>
