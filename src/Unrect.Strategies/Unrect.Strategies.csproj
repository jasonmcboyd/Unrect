<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Three things are shared: AnchorNotFoundException.Description, which ShapeEngine renders;
         CellMatching, so Caption, Field and the matchers agree on what matching means; and the
         Predicate*Landmark classes, which Fields uses to anchor itself on its own first label
         without a public landmark surface being added for it. -->
    <InternalsVisibleTo Include="Unrect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Unrect.Core\Unrect.Core.csproj" />
  </ItemGroup>

</Project>
