<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
  </PropertyGroup>
  <!-- Not packable on its own: the "Unrect" package is produced by Unrect.Engine, which bundles this
       assembly beside the model, Core and Strategies (see Unrect.Engine.csproj). The doc ratchet in
       Directory.Build.targets names this project explicitly for the same reason. The PackageId is
       restore's identity for a project, packable or not; nothing is ever published under this name. -->
  <PropertyGroup>
    <PackageId>Unrect.Fluent</PackageId>
  </PropertyGroup>
  <!-- CS0436: this assembly compiles its own copy of the CallerArgumentExpressionAttribute polyfill
       (a compiler polyfill is per assembly by nature), and the model's internal copy is ALSO visible
       here through the InternalsVisibleTo grant below the table seams still need. The compiler takes
       the local copy, which is the one meant; the warning only says the imported one was shadowed.
       The suppression leaves with the grant. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Unrect.Tests" />
    <!-- A backend's own vocabulary is a first-class part of this one: its terminals close the
         pipeline stage internals. -->
    <InternalsVisibleTo Include="Unrect.Spreadsheets" />
    <!-- The forgiving table is reached through Unrect.Interactive ALONE, which is the point of the
         grant: a shipped declaration does not reference that package, so LooseTable cannot be
         switched on from production code without a reference a reviewer can see. -->
    <InternalsVisibleTo Include="Unrect.Interactive" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Unrect.Projections\Unrect.Projections.csproj" />
    <ProjectReference Include="..\Unrect.Core\Unrect.Core.csproj" />
    <ProjectReference Include="..\Unrect.Strategies\Unrect.Strategies.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A compiler polyfill is per assembly: one source file under src/Polyfills, compiled into
         every project that needs it, never shared through a reference. -->
    <Compile Include="..\Polyfills\CallerArgumentExpressionAttribute.cs" Link="Polyfills\CallerArgumentExpressionAttribute.cs" />
  </ItemGroup>
</Project>
