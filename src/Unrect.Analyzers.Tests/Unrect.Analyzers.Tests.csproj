<Project Sdk="Microsoft.NET.Sdk">

  <!-- net8.0 only, like the benchmarks: this project runs a compiler, and there is nothing about a
       Roslyn analyzer that a second TFM would test. The analyzers themselves are netstandard2.0,
       which is what makes them load in a .NET Framework build of a consumer's project. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The testing harness floors its Roslyn dependency at 1.0.1 — the oldest version an analyzer
       could target — and NuGet takes the floor unless something states otherwise. These two lines
       are that something: without them the restore drags .NET Framework era packages into a net8.0
       project (NU1701, six of them). 4.8 is a HOST version, not the analyzers' target: the analyzers
       compile against 4.4 so that they load everywhere, and are exercised here against a compiler
       newer than that, which is the arrangement a consumer's build has too. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.2" />
  </ItemGroup>

  <!-- The analyzers are referenced as ordinary libraries, not as analyzers: these tests construct
       them and run them over sources of their own. The Unrect projects are referenced so that the
       test compilations can be given the REAL assemblies — a diagnostic about IProjection's demand
       is only worth anything if it is tested against the shipping IProjection. -->
  <ItemGroup>
    <ProjectReference Include="..\Unrect.Analyzers\Unrect.Analyzers.csproj" />
    <ProjectReference Include="..\Unrect.Analyzers.CodeFixes\Unrect.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\Unrect\Unrect.csproj" />
    <ProjectReference Include="..\Unrect.Core\Unrect.Core.csproj" />
    <ProjectReference Include="..\Unrect.Strategies\Unrect.Strategies.csproj" />
    <ProjectReference Include="..\Unrect.Spreadsheets\Unrect.Spreadsheets.csproj" />
  </ItemGroup>

</Project>
