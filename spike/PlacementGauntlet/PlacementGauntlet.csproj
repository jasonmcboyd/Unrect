<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPIKE ONLY. Deliberately outside src/ and outside Unrect.sln: the gauntlet is experiment
       evidence, not a test suite, and MustNotCompile.cs needs a compilation that FAILS on purpose.
       Judged as spike evidence; nothing here ships. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>false</ImplicitUsings>
    <RootNamespace>PlacementGauntlet</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- The scenarios read the committed example workbooks. LINKED rather than copied: the spike must
       not fork the corpus, and a fixture that drifts from the one the scripts parse would make this
       evidence say something no script says. examples/scrubbed-k1.xlsx is NOT here and never will
       be (test-fixture policy) — scenario 5 uses a synthetic in-memory grid instead. -->
  <ItemGroup>
    <Content Include="..\..\examples\simple-report.xlsx" Link="examples\simple-report.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\investors-by-deal.xlsx" Link="examples\investors-by-deal.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\investor-summary.xlsx" Link="examples\investor-summary.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\examples\investor-irr.xlsx" Link="examples\investor-irr.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\Unrect.Tests\TestData\formulas.xlsx" Link="TestData\formulas.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Unrect\Unrect.csproj" />
    <ProjectReference Include="..\..\src\Unrect.Core\Unrect.Core.csproj" />
    <ProjectReference Include="..\..\src\Unrect.Strategies\Unrect.Strategies.csproj" />
    <ProjectReference Include="..\..\src\Unrect.Spreadsheets\Unrect.Spreadsheets.csproj" />
  </ItemGroup>

</Project>
